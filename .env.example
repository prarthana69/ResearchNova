# IBM watsonx.ai credentials
IBM_WATSONX_API_KEY=
IBM_WATSONX_PROJECT_ID=
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com
IBM_WATSONX_MODEL_ID=ibm/granite-13b-chat-v2

# IBM Langflow (optional)
IBM_LANGFLOW_URL=
IBM_LANGFLOW_API_KEY=

# Database
DATABASE_URL=sqlite+aiosqlite:///./researchnova.db

# App settings
SECRET_KEY=change-this-in-production-to-a-random-64-char-string
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# File upload
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads

# External APIs (no key required for OpenAlex/arXiv)
OPENALEX_EMAIL=your-email@example.com
